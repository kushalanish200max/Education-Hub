# =========================================================
# QUIZ
# =========================================================

@app.route("/quiz/<subject>")
def quiz(subject):

    if "user_id" not in session:
        return redirect(url_for("login"))

    if subject not in subjects:
        return "Subject not found"

    questions = subjects[subject]["quiz"]

    # Randomize questions
    questions = questions.copy()
    random.shuffle(questions)

    return render_template(
        "quiz.html",
        subject=subject,
        questions=questions
    )


# =========================================================
# RESULT
# =========================================================

@app.route("/result/<subject>", methods=["POST"])
def result(subject):

    if "user_id" not in session:
        return redirect(url_for("login"))

    questions = subjects[subject]["quiz"]

    score = 0

    for i, question in enumerate(questions):

        user_answer = request.form.get(f"q{i}")

        if user_answer == question["answer"]:
            score += 1

    total = len(questions)

    # Save progress
    conn = get_db()

    conn.execute("""
        INSERT INTO progress(user_id, subject, score, total)
        VALUES (?, ?, ?, ?)
    """, (
        session["user_id"],
        subject,
        score,
        total
    ))

    conn.commit()
    conn.close()

    percentage = (score / total) * 100

    # Personalized recommendation
    if percentage >= 80:

        message = """
        Excellent performance!
        You can move to advanced-level topics.
        """

    elif percentage >= 50:

        message = """
        Good progress!
        Revise the weak topics and try the quiz again.
        """

    else:

        message = """
        You need more practice.
        Start with the basic notes and retry the quiz.
        """

    return render_template(
        "result.html",
        subject=subject,
        score=score,
        total=total,
        percentage=percentage,
        message=message
    )


